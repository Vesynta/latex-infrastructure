# Ignore generated LaTeX outputs from local smoke-test runs.
test/*.aux
test/*.bbl
test/*.bcf
test/*.blg
test/*.fdb_latexmk
test/*.fls
test/*.log
test/*.out
test/*.pdf
test/*.run.xml
test/*.synctex.gz
test/_minted*/

# Local DevContainer overrides (.env.example is the tracked SoT)
.env
.env.local

# Nested sibling clones under .agents/context/ may leak package-manager
# caches onto this DevContainer bind-mount (workspace root).
.pnpm-store/
node_modules/
