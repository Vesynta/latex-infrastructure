# Ignore generated LaTeX outputs from local smoke-test runs.
test/*.aux
test/*.bbl
test/*.bcf
test/*.blg
test/*.fdb_latexmk
test/*.fls
test/*.log
test/*.out
test/*.pdf
test/*.run.xml
test/*.synctex.gz
test/_minted*/

# Local DevContainer overrides (.env.example is the tracked SoT)
.env
.env.local

# Local state that must survive DevContainer rebuilds (e.g. shell history)
.persist/

# Package-manager caches from ad-hoc Node tooling runs
.pnpm-store/
node_modules/
