{
  "mcpServers": {
    "vesynta": {
      "url": "https://mcp.vesynta.com/mcp"
    },
    "aws-mcp": {
      "url": "https://aws-mcp.eu-central-1.api.aws/mcp?oauth=initialize"
    },
    "wrike": {
      "url": "https://mcp.wrike.com/v2",
      "auth": {
        "CLIENT_ID": "${env:WRIKE_MCP_CLIENT_ID}",
        "CLIENT_SECRET": "${env:WRIKE_MCP_CLIENT_SECRET}",
        "scopes": [
          "wsReadWrite"
        ]
      }
    },
    "userback": {
      "url": "https://mcp.userback.io/v1/mcp/"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}
