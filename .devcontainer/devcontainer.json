{
  "name": "latex-infrastructure (maintenance)",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Install the git pre-commit hook, pre-warm hook environments, and sync
  // MCP IDE configs. Commits are expected to happen inside the container
  // (the generated hook references the container's pre-commit).
  "postCreateCommand": "make setup && pre-commit install-hooks",
  "forwardPorts": [8787, 33418],
  "portsAttributes": {
    "8787": {
      "label": "Cursor MCP OAuth callback",
      "onAutoForward": "notify"
    },
    "33418": {
      "label": "VS Code MCP OAuth callback",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "James-Yu.latex-workshop",
        // --- Formatters & linters (mirror .vscode/settings.json) ---
        "exiasr.hadolint",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-containers",
        "bittorala.mdformat",
        "DavidAnson.vscode-markdownlint",
        "TakumiI.markdowntable",
        "ms-python.python",
        "editorconfig.editorconfig",
        "ms-vscode.makefile-tools",
        // --- Collaboration & Utilities ---
        "GitHub.vscode-pull-request-github",
        "ms-vsliveshare.vsliveshare",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-cspell-bundled-dictionaries",
        "mproberts.vscode-pre-commit", // Pre-commit hook visual support
        "usernamehw.errorlens" // Highlights errors/warnings inline in the editor
      ]
    },
    "settings": {
      "extensions.ignoreRecommendations": true
    }
  },
  "remoteUser": "vscode"
}
